---
// An example call record: the per-request cost rows and the latency waterfall the
// dashboard shows for one call. Example usage, priced with voice-prices 0.6.0
// (deepgram/nova-3 for 57 s, gpt-4.1-mini, cartesia/sonic-3), labelled as example.
const rows = [
  { stage: 'STT', model: 'deepgram/nova-3', units: '0.95 audio min', cost: '$0.00456' },
  { stage: 'LLM', model: 'openai/gpt-4.1-mini', units: '1,320 in, 220 out', cost: '$0.00088' },
  { stage: 'TTS', model: 'cartesia/sonic-3', units: '860 chars', cost: '$0.03440' },
];
const total = '$0.03984';
const spans = [
  { label: 'STT final', start: 0, ms: 180 },
  { label: 'LLM first token', start: 180, ms: 320 },
  { label: 'TTS first audio', start: 500, ms: 140 },
];
const ttfa = 640;
---
<figure class="record" aria-label="Example call record: cost per request and latency by stage">
  <figcaption class="head">
    <span class="mono">call 8f2c</span>
    <span class="muted">Example data</span>
  </figcaption>

  <table class="costs">
    <thead class="visually-hidden">
      <tr><th>Stage</th><th>Model and units</th><th>Cost</th></tr>
    </thead>
    <tbody>
      {rows.map((r) => (
        <tr>
          <td class="stage mono">{r.stage}</td>
          <td class="mono"><span class="model">{r.model}</span><span class="units muted">{r.units}</span></td>
          <td class="cost mono">{r.cost}</td>
        </tr>
      ))}
    </tbody>
    <tfoot>
      <tr>
        <td colspan="2">Total call cost</td>
        <td class="cost mono total">{total}</td>
      </tr>
    </tfoot>
  </table>

  <div class="wf">
    <p class="wf-label">Time to first audio <span class="mono">{ttfa} ms</span></p>
    <ol class="bars">
      {spans.map((s, i) => (
        <li style={`--start:${(s.start / ttfa) * 100}%;--width:${(s.ms / ttfa) * 100}%;--i:${i}`}>
          <span class="bar-label">{s.label}</span>
          <span class="track"><span class="bar"></span></span>
          <span class="mono muted ms">{s.ms} ms</span>
        </li>
      ))}
    </ol>
  </div>
</figure>

<style>
  .record {
    margin: 0;
    border: 1px solid var(--vg-line);
    border-radius: 0.75rem;
    background: var(--vg-surface);
    overflow: hidden;
    font-size: 0.875rem;
  }
  .head {
    display: flex; justify-content: space-between;
    padding: 0.75rem 1rem; border-bottom: 1px solid var(--vg-line);
    font-size: 0.8125rem;
  }
  .costs { width: 100%; border-collapse: collapse; }
  .costs td { padding: 0.7rem 1rem; border-bottom: 1px solid var(--vg-line); vertical-align: baseline; }
  .stage { color: var(--vg-muted); width: 3rem; }
  .cost { text-align: right; white-space: nowrap; }
  .model { display: block; overflow-wrap: anywhere; }
  .units { display: block; margin-top: 0.15rem; font-size: 0.75rem; }
  tfoot td { border-bottom: 0; font-weight: 500; }
  .total { color: var(--vg-accent); }

  .wf { padding: 1rem; border-top: 1px solid var(--vg-line); }
  .wf-label { color: var(--vg-muted); font-size: 0.8125rem; margin-bottom: 0.75rem; }
  .wf-label .mono { color: var(--vg-ink); }
  .bars { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; }
  .bars li { display: grid; grid-template-columns: 7.5rem 1fr 3.5rem; align-items: center; gap: 0.75rem; }
  .bar-label { font-size: 0.8125rem; }
  .ms { text-align: right; font-size: 0.8125rem; }
  .track { position: relative; height: 0.5rem; background: var(--vg-line); border-radius: 999px; }
  .bar {
    position: absolute; top: 0; bottom: 0;
    left: var(--start); width: var(--width);
    background: var(--vg-ink); border-radius: 999px;
    transform-origin: left center;
    animation: grow 0.7s var(--vg-ease-out) both;
    animation-delay: calc(0.25s + var(--i) * 0.35s);
  }
  .bars li:last-child .bar { background: var(--vg-accent); }
  @keyframes grow { from { transform: scaleX(0); } to { transform: scaleX(1); } }

  @media (max-width: 34rem) {
    .bars li { grid-template-columns: 6.5rem 1fr 3rem; }
  }
</style>
