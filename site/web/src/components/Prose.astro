---
// A reading page: one column at a comfortable measure.
interface Props { title: string; lead: string }
const { title, lead } = Astro.props;
---
<article class="shell prose">
  <h1>{title}</h1>
  <p class="lead">{lead}</p>
  <slot />
</article>

<style>
  .prose { max-width: 44rem; padding-top: 5rem; }
  h1 { font-size: clamp(2.2rem, 5vw, 3.4rem); line-height: 1.05; letter-spacing: -0.035em; }
  .lead { margin-top: 1.25rem; font-size: 1.125rem; line-height: 1.7; color: var(--vg-prose); }
  .prose :global(h2) { font-size: 1.35rem; letter-spacing: -0.02em; margin-top: 3rem; }
  .prose :global(p), .prose :global(li) { color: var(--vg-prose); line-height: 1.8; }
  .prose :global(p) { margin-top: 0.9rem; }
  .prose :global(ul) { padding-left: 1.2rem; margin: 0.9rem 0 0; }
  .prose :global(li + li) { margin-top: 0.5rem; }
  .prose :global(strong) { color: var(--vg-ink); font-weight: 500; }
</style>
