---
// The split gauge: voice bars run into a solid reading arc, and the needle marks
// the handoff from call to cost. Drawn from the theme, so it follows light and dark.
interface Props { size?: number }
const { size = 26 } = Astro.props;
---
<svg viewBox="9.2 -2.8 81.5 58.8" width={size} height={Math.round((size * 58.8) / 81.5)} aria-hidden="true" class="mark">
  <g fill="none" stroke-width="5.5" stroke-linecap="round">
    <path d="M14 33.8V41.8M23 16.3V30.3M32 6.5V26.5M41 7.1V19.1M50 0V24M59 5.1V21.1M68 11.5V21.5" stroke="var(--vg-ink)" />
    <path d="M74.4 20.9A38 38 0 0 1 88 50" stroke="var(--vg-accent)" />
    <path d="M50 50L63.6 29" stroke="var(--vg-ink)" stroke-width="4.4" />
    <circle cx="50" cy="50" r="6" fill="var(--vg-ink)" stroke="none" />
  </g>
</svg>
