---
// Posts { email, source } to /api/waitlist. A plain form with a small script: no framework.
---
<form class="waitlist" data-waitlist novalidate>
  <label class="visually-hidden" for="waitlist-email">Email address</label>
  <input id="waitlist-email" name="email" type="email" required autocomplete="email" placeholder="you@company.com" aria-describedby="waitlist-status" />
  <button class="btn btn-primary" type="submit">Join the waitlist</button>
  <p id="waitlist-status" class="status" role="status" aria-live="polite" tabindex="-1"></p>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-waitlist]');
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const input = form.querySelector('input')!;
    const button = form.querySelector('button')!;
    const status = form.querySelector<HTMLElement>('.status')!;
    const email = input.value.trim();
    if (!email) {
      status.textContent = 'Enter an email address first.';
      input.setAttribute('aria-invalid', 'true');
      input.focus();
      return;
    }
    input.removeAttribute('aria-invalid');
    button.disabled = input.disabled = true;
    button.textContent = 'Joining';
    status.textContent = '';
    try {
      const res = await fetch('/api/waitlist', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, source: 'landing' }),
      });
      if (res.ok) {
        // Keep the live region so the confirmation is announced, and move focus to it.
        input.remove();
        button.remove();
        status.classList.add('done');
        status.textContent = 'You are on the list. We will write once, when it ships.';
        status.focus();
        return;
      }
      const body = (await res.json().catch(() => ({}))) as { error?: string };
      if (body.error === 'invalid email') input.setAttribute('aria-invalid', 'true');
      status.textContent =
        body.error === 'invalid email'
          ? 'That email address does not look right. Check it and try again.'
          : 'That did not go through. Try again, or email mahi@mahimai.ca.';
    } catch {
      status.textContent = 'That did not go through. Try again, or email mahi@mahimai.ca.';
    }
    button.disabled = input.disabled = false;
    button.textContent = 'Join the waitlist';
  });
</script>

<style>
  .waitlist { display: flex; flex-wrap: wrap; gap: 0.5rem; max-width: 30rem; }
  input {
    flex: 1 1 14rem;
    height: 2.5rem;
    padding: 0 0.875rem;
    border: 1px solid var(--vg-line-strong);
    border-radius: var(--radius);
    background: var(--vg-bg);
    color: var(--vg-ink);
    font: 400 0.9375rem var(--sans);
  }
  input::placeholder { color: var(--vg-muted); }
  input:focus-visible { outline: 2px solid var(--vg-accent); outline-offset: 1px; }
  .status { flex-basis: 100%; min-height: 1.25rem; font-size: 0.875rem; color: var(--vg-bad); }
  .status.done { color: var(--vg-good); }
  .status:focus { outline: none; }
</style>
