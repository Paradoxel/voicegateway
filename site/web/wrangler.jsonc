// voicegateway.dev: prerendered pages served as static assets, plus the Worker for
// the on-demand routes (/api/waitlist, /api/stats, /demo/*). Signups are stored
// in the voicegateway-waitlist D1 database.
//
// Secrets, set once with `npx wrangler secret put <NAME>`:
//   STATS_KEY           guards /api/stats
//   CF_ACCOUNT_ID, CF_EMAIL_API_TOKEN   optional: email on each new signup
// Optional vars: LEAD_NOTIFY_TO, LEAD_FROM.
// Build-time env (not secrets): PUBLIC_POSTHOG_KEY, PUBLIC_POSTHOG_HOST.
{
  "name": "voicegateway-web",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "voicegateway-waitlist", "database_id": "087d0e19-3e37-49a2-8750-ce52072a4f3c" }
  ],
  "routes": [{ "pattern": "voicegateway.dev", "custom_domain": true }],
  "observability": { "logs": { "enabled": true } }
}
